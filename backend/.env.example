# Copy to backend/.env and start with:
#   uvicorn clipsmith.api:app --port 8000 --env-file .env

# mock | funasr | funclip
CLIPSMITH_ENGINE=mock

# ASR (funasr / funclip)
CLIPSMITH_ASR_MODEL=paraformer-zh
CLIPSMITH_ASR_LANG=zh
CLIPSMITH_ASR_DEVICE=cpu
CLIPSMITH_ASR_SPK=0
CLIPSMITH_HOTWORDS=

# FunClip checkout, only for CLIPSMITH_ENGINE=funclip
CLIPSMITH_FUNCLIP_PATH=vendor/FunClip

# LLM selection (any OpenAI-compatible endpoint). Without a key, rules are used.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
CLIPSMITH_LLM_MODEL=deepseek-chat

# Local magpie gateway example (model id must be the full id from /v1/models)
# OPENAI_API_KEY=local
# OPENAI_BASE_URL=http://127.0.0.1:3425/v1
# CLIPSMITH_LLM_MODEL=codearts/deepseek-v4.1-flash-1017

# Clip constraints (seconds)
CLIPSMITH_MIN_CLIP=10
CLIPSMITH_MAX_CLIP=60

# Storage
CLIPSMITH_DATA=data
CLIPSMITH_MAX_UPLOAD_MB=4096